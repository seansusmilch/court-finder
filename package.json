{
  "name": "court-finder",
  "version": "0.0.1",
  "author": "Sean Susmilch",
  "packageManager": "bun@1.2.19",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n S,C \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:backend": "convex dev",
    "dev:backend:setup": "convex dev --configure --until-success",
    "dev:frontend": "vite --port=3001",
    "build": "vite build",
    "serve": "vite preview",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-routes": "tsr generate",
    "check-types": "bun run generate-routes && tsc --noEmit",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@clerk/react": "^6.0.0",
    "@convex-dev/migrations": "^0.3.6",
    "@hookform/resolvers": "^5.9.1",
    "@mapbox/search-js-react": "^1.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.46.0",
    "lucide-react": "^1.47.0",
    "mapbox-gl": "^3.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-image-crop": "^11.1.2",
    "react-map-gl": "^8.1.3",
    "react-zoom-pan-pinch": "^4.2.0",
    "sonner": "^2.0.8",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.38",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
